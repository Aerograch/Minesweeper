<Window x:Class="Сапер.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Сапер"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="MainWindow" Height="1150" Width="900">

    <Window.Resources>
        <Style TargetType="Button" x:Key="RoundButton">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="Label" x:Key="ThreeNumberLabels">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>
    
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="155"/>
            <RowDefinition Height="900"/>
        </Grid.RowDefinitions>
        <Menu>
            <MenuItem Header="_About" FontSize="25">
                <MenuItem Header="_Info" Click="InfoOptionOnClick"/>
                <MenuItem Header="_Author" Click="AuthorOptionOnClick"/>
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Name="BombCountLabel" Style="{DynamicResource ThreeNumberLabels}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0" FontSize="40" Content="000" Grid.Column="0"/>
            <Button Name="ResetButton" Style="{DynamicResource RoundButton}" Click="ResetButtonOnCluck" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="100" FontSize="35" Content="Reset" Grid.Column="1"/>
            <Label Name="TimeElapsedLabel" Style="{DynamicResource ThreeNumberLabels}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,30,0" FontSize="40" Content="000" Grid.Column="2"/>
        </Grid>
        
        
        <Border Grid.Row="2" Margin="40" BorderThickness="10" BorderBrush="Gray" CornerRadius="5">
            <Grid Name="FieldGrid" Background="LightGray">

            </Grid>
        </Border>
    </Grid>
</Window>
